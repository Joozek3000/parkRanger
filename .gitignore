# Unity (based on github/gitignore Unity.gitignore, prefixed for Unity/)
/Unity/[Ll]ibrary/
/Unity/[Tt]emp/
/Unity/[Oo]bj/
/Unity/[Bb]uild/
/Unity/[Bb]uilds/
/Unity/[Ll]ogs/
/Unity/[Uu]ser[Ss]ettings/
/Unity/[Mm]emoryCaptures/
/Unity/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/Unity/[Aa]ssets/**/*.meta

# Autogenerated by plugins / build
/Unity/[Aa]ssets/Plugins/Editor/JetBrains*
/Unity/[Aa]ssets/[Ss]treamingAssets/aa/*
/Unity/[Aa]ssets/[Ss]treamingAssets/aa.meta

# IDE / generated project files
/Unity/.vs/
/Unity/.vscode/
/Unity/.idea/
/Unity/.gradle/
/Unity/ExportedObj/
/Unity/.consulo/
/Unity/*.csproj
/Unity/*.unityproj
/Unity/*.sln
/Unity/*.slnx
/Unity/*.suo
/Unity/*.tmp
/Unity/*.user
/Unity/*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash / build reports
sysinfo.txt
crashlytics-build.properties
/Unity/[Aa]ssets/[Ss]treamingAssets/build_info*
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Builds
*.apk
*.aab
*.unitypackage.tmp

# Blender backups
*.blend1
*.blend2
*.blend@

# OS files
Thumbs.db
Desktop.ini
.DS_Store

/_to_delete/

# blender-lpm-skill scratch output
/_work/
